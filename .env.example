# Database — the app connects to the `db` service on the compose network.
# DB_PASSWORD is the single source of truth for the Postgres password;
# DATABASE_URL embeds it. Keep them in sync.
DB_PASSWORD=change-me
DATABASE_URL=postgres://habithero:change-me@db:5432/habithero

# NextAuth — generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-openssl-rand-base64-32
# Public base URL of the deployed app (include BASE_PATH sub-path if any).
NEXTAUTH_URL=http://localhost:4000

# Agent/service API — the gateway sends this as the `x-agent-token` header when
# calling the REST API on a channel user's behalf. Generate with:
#   openssl rand -base64 32
AGENT_API_TOKEN=change-me-openssl-rand-base64-32

# Chore-completion photos are stored on a local mounted volume (decision #1),
# not object storage. Defaults to ./data/photos when unset.
PHOTO_DIR=./data/photos
