# API key to authenticate claude gateway apis
GATEWAY_API_KEY=

# --- generate these three, do not invent them by hand ------------------------
# Postgres password. Strip / + = — this value is embedded in DATABASE_URL
# (postgres://habithero:<pass>@db:5432/habithero) and a single / makes the whole
# URL unparseable.
#   openssl rand -base64 24 | tr -d '/+='
DB_PASSWORD=

# NextAuth session-signing key — unique per install.
#   openssl rand -base64 32
NEXTAUTH_SECRET=

# Shared token the agent sends as `x-agent-token`. The app and agent containers
# read it from the same generated .env, so they always match.
#   openssl rand -base64 32
AGENT_API_TOKEN=

# --- fill this in too, no need to ask anyone ---------------------------------
# The URL the app is opened at. http://localhost:3737 is correct for every
# topology — local, LAN IP, or a public https domain forwarding to this port —
# because the session cookie name is derived from this same value on both the
# write and read side, independent of the request protocol.
# install.sh already falls back to http://localhost:3737 when this is unset.
# Set an https URL only if the app is reached over https exclusively and you
# want the Secure cookie flag; that choice blocks http access entirely.
NEXTAUTH_URL=
