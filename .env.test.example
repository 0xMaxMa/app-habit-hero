# Test environment — copy to `.env.test` for local integration/E2E runs:
#   cp .env.test.example .env.test
#
# These are throwaway values for a LOCAL, disposable Postgres. Never point them
# at a real database. CI injects its own values (see .github/workflows/ci.yml),
# and tests/integration/load-env.ts never overrides an already-set variable.

DATABASE_URL=postgres://habithero:test@localhost:5433/habithero_test
AGENT_API_TOKEN=test-agent-token
NEXTAUTH_SECRET=test-secret-please-change
NEXTAUTH_URL=http://localhost:4000
