# --- dependencies / build output -------------------------------------------
node_modules/
.next/
out/
build/
coverage/
*.tsbuildinfo
next-env.d.ts

# --- test output ------------------------------------------------------------
test-results/
playwright-report/

# --- secrets ----------------------------------------------------------------
# Every .env is machine-local and holds real credentials (DB password,
# NEXTAUTH_SECRET, AGENT_API_TOKEN, GATEWAY_API_KEY). Only *.example is tracked.
.env
.env.*
**/.env
**/.env.*
!*.example
!**/*.example

# --- runtime data (never belongs in the repo) -------------------------------
# Postgres data directory (bind-mounted by the compose stack).
postgres/
# Uploaded chore photos + user avatars — real family photos.
data/photos/
data/

# --- gateway / agent runtime state ------------------------------------------
# docker-compose.yml is GENERATED by claude-gateway from app.yaml at install
# time and embeds absolute host paths, so it is machine-specific. app.yaml is
# the source of truth that ships with the repo.
docker-compose.yml
#
# agent/ is not an ordinary source directory. The gateway bind-mounts it into
# the agent container as /workspace and writes to it while the app runs, so it
# is a live scratch space that happens to sit inside a git checkout — and this
# repo is public. What lands there is open-ended and grows with the gateway:
# CLAUDE.md (composed on every boot from the files below plus the host's own
# skill list), MEMORY.md and USER.md, an episodic memory/ tree, .dreaming/,
# .claude/, per-channel state dirs, and whatever notes or scratch files the
# agent decides to write. On a real install every one of those can carry the
# family's private data — children's names, their HabitHero user ids, the
# parent's channel_user_ref.
#
# So this is an allowlist, not a deny-list: naming the generated files one by
# one only holds until the gateway invents the next one, and the failure is
# silent and public. Ignore everything, then re-admit the handful of files
# that are genuinely source. Adding a new authored file here means adding a
# matching "!" line — tests/unit/agent-workspace-hygiene.test.ts fails loudly
# if the two ever drift apart.
agent/*
!agent/.gitkeep
!agent/AGENTS.md
!agent/SOUL.md
!agent/skills/
# skills/ stays tracked because it ships with the app. Note the gateway can
# also write here: a workspace-scoped skill_create lands in
# agent/skills/<name>/SKILL.md. That shows up as an untracked file rather than
# being silently ignored, which is the behaviour we want — it is visible.

# --- design working files ---------------------------------------------------
# The whole directory stays private: PRD, task board, design prompts and the
# Cozy mockup are internal working material, not part of what this repo ships.
# Removed from history too — do not re-add.
design/

# --- misc -------------------------------------------------------------------
.DS_Store
*.log

# Test photo uploads (PHOTO_DIR in .env.test)
.tmp/
