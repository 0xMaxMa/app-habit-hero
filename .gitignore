# --- dependencies / build output -------------------------------------------
node_modules/
.next/
out/
build/
coverage/
*.tsbuildinfo
next-env.d.ts

# --- test output ------------------------------------------------------------
test-results/
playwright-report/

# --- secrets ----------------------------------------------------------------
# Every .env is machine-local and holds real credentials (DB password,
# NEXTAUTH_SECRET, AGENT_API_TOKEN, GATEWAY_API_KEY). Only *.example is tracked.
.env
.env.*
**/.env
**/.env.*
!*.example
!**/*.example

# --- runtime data (never belongs in the repo) -------------------------------
# Postgres data directory (bind-mounted by the compose stack).
postgres/
# Uploaded chore photos + user avatars — real family photos.
data/photos/
data/

# --- gateway / agent runtime state ------------------------------------------
# docker-compose.yml is GENERATED by claude-gateway from app.yaml at install
# time and embeds absolute host paths, so it is machine-specific. app.yaml is
# the source of truth that ships with the repo.
docker-compose.yml
# Per-session agent scratch state written by the gateway at runtime.
agent/.sessions/
agent/.telegram-state/
agent/.discord-state/
agent/.line-state/
agent/.dreaming/
# agent/CLAUDE.md is GENERATED, exactly like docker-compose.yml above: the
# gateway composes it from AGENTS.md + SOUL.md + USER.md + MEMORY.md plus the
# skill list of whatever host it boots on, and rewrites it on every start and
# on every workspace edit. A committed copy is therefore always stale, and it
# leaks the host's unrelated skills into this repo. AGENTS.md, SOUL.md and
# skills/ are the sources that ship; this is their build output.
agent/CLAUDE.md
# MEMORY.md and USER.md are the agent's runtime memory. In a real install they
# hold one family's private data — children's names, their HabitHero user ids
# and the parent's channel_user_ref. This repo is public, so they stay out of
# it. The gateway creates MEMORY.md empty on first boot and carries it across
# app updates; USER.md is optional and only exists if someone writes one, and
# an app update does NOT preserve it. See "Long-term memory" in agent/AGENTS.md.
agent/MEMORY.md
agent/USER.md

# --- design working files ---------------------------------------------------
# The whole directory stays private: PRD, task board, design prompts and the
# Cozy mockup are internal working material, not part of what this repo ships.
# Removed from history too — do not re-add.
design/

# --- misc -------------------------------------------------------------------
.DS_Store
*.log

# Test photo uploads (PHOTO_DIR in .env.test)
.tmp/
